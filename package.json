{
  "name": "bms",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "pnpm --filter @bms/shared build && pnpm --filter @bms/db build && pnpm --filter api build && pnpm --filter web build",
    "typecheck": "pnpm build",
    "postinstall": "pnpm --filter @bms/shared build && pnpm --filter @bms/db build",
    "db:migrate": "pnpm --filter @bms/db migrate",
    "db:seed": "pnpm --filter @bms/db seed",
    "db:generate": "pnpm --filter @bms/db generate",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:onboarding": "vitest run onboarding credential-crypto admin-access rtu-config"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.10",
    "tsx": "^4.19.2",
    "typescript": "~5.7.3",
    "vitest": "^4.1.10"
  }
}
