{
  "name": "bms",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "postinstall": "pnpm --filter @bms/shared build && pnpm --filter @bms/db build",
    "db:migrate": "pnpm --filter @bms/db migrate",
    "db:seed": "pnpm --filter @bms/db seed",
    "db:generate": "pnpm --filter @bms/db generate"
  },
  "devDependencies": {
    "typescript": "~5.7.3"
  }
}
