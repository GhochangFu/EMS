{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/check-dependency-adr.mjs"
          },
          {
            "type": "command",
            "command": "node .claude/hooks/check-applied-migration-edit.mjs"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/check-style-hygiene.mjs"
          },
          {
            "type": "command",
            "command": "node .claude/hooks/check-drizzle-journal.mjs"
          }
        ]
      }
    ]
  }
}
