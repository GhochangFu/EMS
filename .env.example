# Docker Compose — copy to `.env` in this directory (never commit `.env`).
# Used by the `ingest` service (profile: phe / ingest / pilot).

MQTT_USERNAME=pheadmin
MQTT_PASSWORD=change-me

# AI onboarding wizard (apps/api) — 32-byte key, base64-encoded
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIAL_ENCRYPTION_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# OpenAPI docs (apps/api) — ADR 0029 Amendment 2.
# Where served, /api/v1/docs and its document are UNAUTHENTICATED: the complete
# route inventory, readable by anyone who can reach the port. Swagger UI cannot
# send a bearer token when it fetches a spec, so a guarded document is
# unreadable from a browser and the choice is "absent" or "open".
# Unset  -> enabled everywhere except NODE_ENV=production.
# true   -> enabled, including in production. Publishes the inventory.
# false  -> disabled everywhere.
API_DOCS_ENABLED=

# Notifications (apps/api) — ADR 0041 (`F3.8`).
#
# SMTP_HOST is what decides whether email works at all. Empty means the email
# transport is NOT constructed: every email channel records a
# `skipped_unconfigured` delivery and the readiness banner says so. That is
# deliberate — there is no default host anywhere, because a fallback would send
# real alarm text at whatever happens to be listening.
#
# To watch mail locally: `docker compose --profile mail up -d`, then
# SMTP_HOST=localhost and SMTP_PORT=1025. The inbox is http://localhost:8025.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Only the exact string `true` enables TLS on the SMTP connection.
SMTP_SECURE=

# Per channel, per hour. Empty uses 60 (ADR 0041 decision 7).
NOTIFY_RATE_LIMIT_PER_HOUR=

# LOCAL DEVELOPMENT ONLY. Only the exact string `true` allows a webhook channel
# to POST over plain http. It does NOT relax the other half of the egress
# guard: a target that resolves to a loopback, private or link-local address is
# refused either way. Never set this on a pilot host, and never add it to
# docker-compose.yml — a repo invariant fails the build if it appears there.
NOTIFY_WEBHOOK_ALLOW_INSECURE=
