# Docker Compose — copy to `.env` in this directory (never commit `.env`).
# Used by the `ingest` service (profile: phe / ingest / pilot).

MQTT_USERNAME=pheadmin
MQTT_PASSWORD=change-me

# Object storage (`F3.3`, ADR 0066) — the MinIO root credentials the compose
# `minio` service starts with, and that `api` and `api-replica` authenticate
# against. DEV ONLY: the defaults in docker-compose.yml are committed, the
# console and the S3 port bind 127.0.0.1, and nothing here is encrypted at
# rest or in transit (decision 8). A hosted deployment injects real
# credentials from a secret store and never reads this file. MinIO refuses a
# root password under 8 characters.
MINIO_ROOT_USER=bms_minio_dev
MINIO_ROOT_PASSWORD=bms_minio_dev_secret

# The six the API reads (ADR 0066 decision 3). docker-compose.yml already
# sets all six on `api` and `api-replica`, so these are for a NATIVE run
# (`pnpm --filter api dev`) against the compose MinIO on loopback. Unset,
# the API boots with `storage: { configured: false }` on /health and both
# asset-image routes answer 503 — a chosen state, not a boot failure. Set
# them and all six must be valid: a missing bucket or key is a boot error.
# OBJECT_STORAGE_ENDPOINT=http://127.0.0.1:9000
# OBJECT_STORAGE_BUCKET=bms-asset-images
# OBJECT_STORAGE_ACCESS_KEY=bms_minio_dev
# OBJECT_STORAGE_SECRET_KEY=bms_minio_dev_secret
# OBJECT_STORAGE_REGION=us-east-1
# OBJECT_STORAGE_FORCE_PATH_STYLE=true
# Only the exact string `true` lets the API accept a plain-http endpoint
# (decision 8). This is the DEV value and compose reads it for `api` and
# `api-replica` (ADR 0066 Amendment 2: the compose default is empty, so
# without this line the `http://minio:9000` default refuses the boot). A
# hosted deployment leaves it unset and uses an https:// endpoint.
OBJECT_STORAGE_ALLOW_INSECURE=true

# AI onboarding wizard (apps/api) — 32-byte key, base64-encoded
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIAL_ENCRYPTION_KEY=
# Accepted for DECRYPTION ONLY, during a key rotation window (ADR 0062). Never
# used to encrypt. Two conditions, and BOTH refuse the boot of the API and the
# ingest alike, not the first request: leave this empty unless
# CREDENTIAL_ENCRYPTION_KEY is also set, AND unless
# CREDENTIAL_ENCRYPTION_KEY_VERSION is 2 or higher — at version 1 the previous
# key would be version 0, which no row can hold.
CREDENTIAL_ENCRYPTION_KEY_PREVIOUS=
# The version CREDENTIAL_ENCRYPTION_KEY writes. Empty defaults to 1. The
# previous key, if set, always decrypts at this version minus one.
CREDENTIAL_ENCRYPTION_KEY_VERSION=
# Onboarding agent (apps/api) — F3.21, ADR 0090 Amendment 1 A2. The platform
# default for organizations that set no provider of their own on the
# AI assistant page. LLM_PROVIDER is openai, openrouter or anthropic; empty
# turns the agent off and the guided (rule-based) mode answers. The selected
# provider needs its key, and OpenRouter also needs a model (no default). One
# turn makes at most 8 tool calls and runs at most 45 s.
LLM_PROVIDER=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Administrator copilot daily turn limits (apps/api) — F3.85, ADR 0099
# decision 11 and Amendment 1. A turn over either limit is refused before any
# model call, with the reset time. The user limit counts across organizations;
# its day is the user's home organization's timezone (UTC for the global
# admin). The organization limit's day is that organization's timezone. Empty,
# not an integer, or not above 0 uses the default; never 0. Read at boot.
COPILOT_USER_DAILY_TURNS=150
COPILOT_ORG_DAILY_TURNS=1500

# Auth (apps/api) — F3.78 / ADR 0089 decision 5. Under OIDC the API accepts
# only a token whose `azp` claim equals OIDC_CLIENT_ID; it has no default, and
# unset it refuses every token with 401 "OIDC client id is not configured".
# docker-compose.yml sets `bms-web` on `api` and `api-replica`; this line is
# for a NATIVE run against the compose Keycloak. Ignored under local auth.
# OIDC_CLIENT_ID=bms-web

# User administration (apps/api) — F3.78 / ADR 0089 decision 5. The secret of
# the `bms-api-admin` Keycloak client. It is EQUIVALENT TO GLOBAL ADMIN
# (`manage-users` can set any realm user's password): never commit it, never
# reuse it across hosts. Generate one per host with
#   openssl rand -base64 32
# `docker compose up` passes it to `api`, `api-replica` and the one-shot
# `keycloak-provision` job, which sets it on the client. Empty, user
# administration is not configured: the write routes answer 503, reads work,
# and `keycloak-provision` exits 1. Runbook:
# docs/runbooks/keycloak-user-administration.md. A NATIVE API run also needs
# KEYCLOAK_ADMIN_URL=http://keycloak:8080 (with a `keycloak` hosts entry),
# KEYCLOAK_ADMIN_REALM=bms and KEYCLOAK_ADMIN_CLIENT_ID=bms-api-admin.
KEYCLOAK_ADMIN_CLIENT_SECRET=

# OpenAPI docs (apps/api) — ADR 0029 Amendment 2.
# Where served, /api/v1/docs and its document are UNAUTHENTICATED: the complete
# route inventory, readable by anyone who can reach the port. Swagger UI cannot
# send a bearer token when it fetches a spec, so a guarded document is
# unreadable from a browser and the choice is "absent" or "open".
# Unset  -> enabled everywhere except NODE_ENV=production.
# true   -> enabled, including in production. Publishes the inventory.
# false  -> disabled everywhere.
API_DOCS_ENABLED=

# Notifications (apps/api) — ADR 0041 (`F3.8`).
#
# SMTP_HOST is what decides whether email works at all. Empty means the email
# transport is NOT constructed: every email channel records a
# `skipped_unconfigured` delivery and the readiness banner says so. That is
# deliberate — there is no default host anywhere, because a fallback would send
# real alarm text at whatever happens to be listening.
#
# To watch mail locally: `docker compose --profile mail up -d`, then
# SMTP_HOST=localhost and SMTP_PORT=1025. The inbox is http://localhost:8025.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Only the exact string `true` enables TLS on the SMTP connection.
SMTP_SECURE=

# Per channel, per hour. Empty uses 60 (ADR 0041 decision 7).
#
# Since `F3.52` (ADR 0041 Amendment 6) this is one count against two limits. A
# raise may use the whole ceiling; an escalation step, a cleared message and a
# Send test stop at 80% of it, so a fifth of the ceiling stays reachable by a
# raise alone. At a ceiling of 1 the reserved limit rounds to 0 and only raises
# send.
NOTIFY_RATE_LIMIT_PER_HOUR=

# How late a due escalation step may be before the sweep abandons it and writes
# a `skipped_stale` delivery row instead of sending it (`F3.52`, ADR 0041
# Amendment 6 §2). Minutes. Empty uses 60, which matches the rate limit's own
# trailing hour: a step that could not fit inside one full ceiling window is
# over budget rather than merely queued.
#
# An unparseable, zero, negative or overflowing value falls back to 60 rather
# than becoming NaN or Infinity — either would compare false against every
# comparison and REMOVE the cut-off rather than relax it.
NOTIFY_STEP_MAX_LATENESS_MINUTES=

# LOCAL DEVELOPMENT ONLY. Only the exact string `true` allows a webhook channel
# to POST over plain http. It does NOT relax the other half of the egress
# guard: a target that resolves to a loopback, private or link-local address is
# refused either way. Never set this on a pilot host, and never add it to
# docker-compose.yml — a repo invariant fails the build if it appears there.
NOTIFY_WEBHOOK_ALLOW_INSECURE=

# Copilot history purge (worker) — F3.85, ADR 0099 decision 8. How often the
# worker deletes copilot conversations untouched for 30 days (their messages go
# with them), orphaned pending/rejected changes older than 30 days, and fails
# `applying` claims older than 30 days. Milliseconds. Empty uses 86400000 (one
# day). Anything but a positive integer — blank, 0, negative, not a number —
# also falls back to 86400000; the worker never refuses to start over it.
COPILOT_PURGE_INTERVAL_MS=
