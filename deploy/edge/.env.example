# The edge gateway's environment (E7.2, ADR 0123). Copy to `.env` beside
# docker-compose.yml and fill in. `.env` holds secrets: never commit it.
# Docs: docs/edge-gateway.md.

# The cloud origin, https only, no path (the client posts to /edge/v1/batches).
EDGE_UPLINK_URL=https://ems.example.com

# The gateway's token, minted once on the admin page. bmsgw_ + 43 characters.
EDGE_GATEWAY_TOKEN=

# Buffer bounds. Defaults: 72 h (ceiling 6 d = 518400000) and 1 GiB.
# EDGE_BUFFER_MAX_AGE_MS=259200000
# EDGE_BUFFER_MAX_BYTES=1073741824

# Backlog replay cap, samples per second (default 500, floor 50).
# EDGE_REPLAY_MAX_SAMPLES_PER_S=500

# Plain MQTT is refused unless the broker host is listed here (ADR 0114).
# MQTT_PLAINTEXT_HOSTS=

# Device credentials, one variable per name the config file references.
# Names match ^EDGE_CRED_[A-Z0-9_]+$.
EDGE_CRED_SITE_BROKER_USER=
EDGE_CRED_SITE_BROKER_PASSWORD=
