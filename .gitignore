# --- Dependencies -----------------------------------------------------------
node_modules/
.pnpm-store/

# --- Build output -----------------------------------------------------------
dist/
build/
out/
.next/
.nuxt/
.turbo/
.cache/
.vite/

# --- TypeScript -------------------------------------------------------------
*.tsbuildinfo

# --- Env files --------------------------------------------------------------
# Real env files are never committed. Examples (.env.example) are committed.
.env
.env.local
.env.*.local
*.env
!.env.example
!.env.*.example

# --- Docker -----------------------------------------------------------------
# Machine-specific compose overrides (host port remaps, local tweaks).
docker-compose.override.yml

# --- Logs -------------------------------------------------------------------
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# --- Test / coverage --------------------------------------------------------
coverage/
.nyc_output/
.vitest-cache/
playwright-report/
test-results/

# --- IDE / OS ---------------------------------------------------------------
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
!.vscode/settings.recommended.json
.idea/
*.swp
*.swo

# --- Local DB / scratch -----------------------------------------------------
pgdata/
postgres-data/
*.dump
*.sql.bak
.scratch/
TODO.local.md

# --- Drizzle local artifacts -----------------------------------------------
drizzle/.snapshot.json.bak
.claude/worktrees/

# --- Generated build-status dashboard ---------------------------------------
# Rebuilt by docs/scripts/backlog-dashboard.mjs on every run, and by the routine
# that republishes the artifact. Committing them would churn the diff on every
# cycle for output nobody reviews. See docs/status/README.md.
docs/status/backlog-status.json
docs/status/backlog-dashboard.html
docs/status/backlog-dashboard.standalone.html
docs/status/backlog-dashboard.client.html

# Advanced only after a successful artifact publish, so a failed publish cannot
# be mistaken for "nothing changed". See docs/status/README.md.
docs/status/.published-fingerprint

# F4.31 — `pnpm csv:formula-probe` writes these into the cwd for manual
# opening in Excel / LibreOffice / Sheets. They are artifacts of a check, not
# inputs to one: the script regenerates them from the real `csvTextCell`.
csv-formula-probe.csv
csv-formula-probe-bom.csv
