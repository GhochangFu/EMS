  "_about": {
    "what": "Sheet 02 - Electrical Distribution Overview, from docs/ion-exchange-nexus-dashboard-2026-08-29.html, expressed as the two request bodies the dashboard builder itself sends.",
    "scope": "ESKOM / RSMOC Western Cape - the site with the most active alarms (27) and the most electrical points (21 kw, 21 pf).",
    "notForProduction": "A demo definition only. It is deliberately NOT in packages/db seeds, so it never reaches a production or a freshly seeded database. Replay it by hand when a local database needs it.",
    "howToReplay": [
      "1. POST /api/v1/dashboards with the `create` body. Keep the returned id.",
      "2. PUT /api/v1/dashboards/<id>/widgets with the `widgets` body.",
      "3. Both calls need a bearer token. AUTH_MODE=oidc has no direct grant, so take the token from the web app's localStorage after a browser login.",
      "4. The pointId values below are seed-specific. A re-seeded database gives new ids - re-read them from bms.asset_points before replay."
    ],
    "chartWindow": "Feeder Load Trend uses windowMinutes 60, not the sheet's Period: Today. The simulator writes from the moment it starts, so a 1440-minute window plots a day of empty axis beside a few minutes of data. Widen it to 1440 once the site has a day of history.",
    "notBuildable": {
      "singleLineDiagram": "F3.32, the mimic builder. The proposal itself stamps this block MIMIC BUILDER +3M.",
      "maintenanceWorkflowFunnel": "No widget type exists for it.",
      "energyTodayMWh": "ESKOM carries no kwh_total point - only PHEWB does. Replaced by Average Load Today (kW) rather than binding an MWh label to a kW reading."
    }
