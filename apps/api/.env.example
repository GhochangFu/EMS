# Owner connection — used by `db:seed`, `apps/sim` and `apps/ingest`, never by
# the API itself. Keep it even though the API connects via the three roles
# below (ADR 0043 decision 8): those scripts load this same file.
#
# **This must name `bms_owner`, not `bms_app`** (ADR 0045). `bms_owner` is the
# non-superuser schema owner that `FORCE ROW LEVEL SECURITY` binds. Pointing it
# back at `bms_app` silently restores a superuser here, and a superuser bypasses
# every tenant policy regardless of FORCE — the seed's per-organization grouping
# becomes decorative and every owner-side check passes vacuously, with nothing
# failing to say so.
DATABASE_URL=postgres://bms_owner:bms_owner_dev@localhost:5432/bms

# Provisioning superuser. Read by `db:roles`, `db:migrate` and `db:seed` (ADR
# 0045 decision 3; ADR 0043 decision 5 + Amendment 4), and — outside those —
# only by the integration-test gate
# (`apps/api/src/testing/integration-db-gate.ts`), which is a test helper that
# never ships. It must never reach the running API.
# `db:roles` needs it for `CREATE ROLE` and `ALTER ROLE ... BYPASSRLS`;
# `db:migrate` needs it because a fresh database replays migration 0039, whose
# line 33 requires SUPERUSER; `db:seed` needs it since `E7.1b` for the three
# identity functions only, because `bms.users` has FORCE ROW LEVEL SECURITY and
# every seeded login is org-less. Unset, `db:seed` derives
# `bms_app:bms_app_dev` from DATABASE_URL and fails with 42501 if that password
# is not the one in use.
DATABASE_URL_SUPERUSER=postgres://bms_app:bms_app_dev@localhost:5432/bms

# The API always connects as one of these three, never as the owner — there
# is deliberately no fallback to DATABASE_URL if one is missing. Run
# `pnpm --filter @bms/db roles` once **before** `db:migrate` (ADR 0045
# decision 6) — it creates these roles, and 0041 fails with
# `role "bms_owner" does not exist` if the migrations run first.
DATABASE_URL_AUTH=postgres://bms_auth:bms_auth_dev@localhost:5432/bms
DATABASE_URL_TENANT=postgres://bms_tenant:bms_tenant_dev@localhost:5432/bms
DATABASE_URL_FLEET=postgres://bms_fleet:bms_fleet_dev@localhost:5432/bms

# Read only by `pnpm db:roles`, to set LOGIN + a password on the roles above.
# `bms_owner` is included since ADR 0045 — `db:roles` refuses to run without it,
# and every DATABASE_URL connection above would then fail to authenticate.
#
# `bms_rollup` is deliberately absent and needs no entry: it owns the four
# continuous aggregates, is assumed via SET ROLE rather than connected to, and
# holds LOGIN with **no password** so that only TimescaleDB's background workers
# can use it.
BMS_OWNER_PASSWORD=bms_owner_dev
BMS_AUTH_PASSWORD=bms_auth_dev
BMS_TENANT_PASSWORD=bms_tenant_dev
BMS_FLEET_PASSWORD=bms_fleet_dev

JWT_SECRET=change-me-in-prototype
JWT_TTL=8h
AUTH_MODE=local
# Sprint C OIDC mode:
# AUTH_MODE=oidc
# OIDC_ISSUER=http://localhost:8080/realms/bms
# OIDC_JWKS_URI=http://localhost:8080/realms/bms/protocol/openid-connect/certs
# OIDC_AUDIENCE=bms-web
OTEL_SERVICE_NAME=bms-api
# OTEL_SDK_DISABLED=true
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
PORT=4000
LOG_LEVEL=info
# Indicative ZAR/kWh for Energy Centre cost tile (Sprint 8).
ENERGY_TARIFF_ZAR_PER_KWH=2.15
