# Owner connection — used only by `db:migrate`/`db:seed`/`db:roles`, never by
# the API itself. Keep it even though the API connects via the three roles
# below (ADR 0043 decision 8): those scripts load this same file.
DATABASE_URL=postgres://bms_app:bms_app_dev@localhost:5432/bms

# The API always connects as one of these three, never as the owner — there
# is deliberately no fallback to DATABASE_URL if one is missing. Run
# `pnpm --filter @bms/db roles` once after `db:migrate` so they can log in.
DATABASE_URL_AUTH=postgres://bms_auth:bms_auth_dev@localhost:5432/bms
DATABASE_URL_TENANT=postgres://bms_tenant:bms_tenant_dev@localhost:5432/bms
DATABASE_URL_FLEET=postgres://bms_fleet:bms_fleet_dev@localhost:5432/bms

# Read only by `pnpm db:roles`, to set LOGIN + a password on the three roles
# above.
BMS_AUTH_PASSWORD=bms_auth_dev
BMS_TENANT_PASSWORD=bms_tenant_dev
BMS_FLEET_PASSWORD=bms_fleet_dev

JWT_SECRET=change-me-in-prototype
JWT_TTL=8h
AUTH_MODE=local
# Sprint C OIDC mode:
# AUTH_MODE=oidc
# OIDC_ISSUER=http://localhost:8080/realms/bms
# OIDC_JWKS_URI=http://localhost:8080/realms/bms/protocol/openid-connect/certs
# OIDC_AUDIENCE=bms-web
OTEL_SERVICE_NAME=bms-api
# OTEL_SDK_DISABLED=true
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
PORT=4000
LOG_LEVEL=info
# Indicative ZAR/kWh for Energy Centre cost tile (Sprint 8).
ENERGY_TARIFF_ZAR_PER_KWH=2.15
