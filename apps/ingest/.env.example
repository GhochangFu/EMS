MQTT_HOST=phe.thinkiot.co.in
MQTT_PORT=8883
MQTT_USERNAME=
MQTT_PASSWORD=
# The host owns reconnect and binds INGEST_HOST_HEALTH_PORT (default 9103).
# MQTT_RECONNECT_MS and INGEST_METRICS_PORT were read only by the ADR 0007 entry
# point, deleted at ADR 0016 §6 commit 4.
INGEST_HOST_HEALTH_PORT=9103
# The disk buffer's directory (ADR 0016 Amendment 4). Default is the compose
# image's path; a local run on Windows, or on Linux where /var/lib is
# root-owned, must set this — the host refusing to start over an unwritable
# default is ruling 4 working, not a bug.
INGEST_BUFFER_DIR=
# Rolling window, by receipt time, before a buffered segment is erased.
INGEST_BUFFER_MAX_AGE_MS=
# Host-wide byte ceiling across every endpoint's buffered segments.
INGEST_BUFFER_MAX_BYTES=
# How old a written row may be and still be sent to live dashboards and the
# alarm engine (ADR 0123 decision 10). Older rows, such as a replay after an
# outage, are written as history and not notified. Default 300000 (5 min);
# 60000 to 900000 is accepted and anything else refuses start-up.
INGEST_NOTIFY_LIVE_WINDOW_MS=
# The edge uplink receiver's port (E7.2, ADR 0123 decision 4): POST
# /edge/v1/batches from site edge gateways. Unset means no listener. Must
# differ from INGEST_HOST_HEALTH_PORT.
INGEST_UPLINK_PORT=
# `bms_owner`, not `bms_app` (ADR 0045). The ingest host writes as the schema
# owner, which is deliberately not a superuser so FORCE ROW LEVEL SECURITY
# binds it.
DATABASE_URL=postgres://bms_owner:bms_owner_dev@localhost:5432/bms
