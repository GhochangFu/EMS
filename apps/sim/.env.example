# `bms_owner`, not `bms_app` (ADR 0045). The simulator writes as the schema
# owner, which is deliberately not a superuser so FORCE ROW LEVEL SECURITY
# binds it.
DATABASE_URL=postgres://bms_owner:bms_owner_dev@localhost:5432/bms
SIM_RATE_HZ=1
# Use `all` to cover every seeded asset, or a number to cap rows ordered by asset code.
SIM_ASSET_COUNT=all
SIM_METRICS_PORT=9101
